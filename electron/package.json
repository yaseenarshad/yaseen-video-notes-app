{
  "name": "yaseen-video-notes",
  "productName": "Yaseen Video Notes",
  "private": true,
  "version": "0.2.0",
  "description": "Yaseen Video Notes (formerly Follow Along): watch YouTube talks at 2–3× with a transcript that follows the video, notes saved in the transcript markdown (Electron)",
  "author": "Yasin Arshad",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "package": "node scripts/package.mjs",
    "install-app": "node scripts/install-app.mjs",
    "cli": "node out/main/cli.js",
    "dev:labs": "VIDEO_NOTES_FLAVOR=labs electron-vite dev --entry out-labs/main/index.js",
    "build:labs": "VIDEO_NOTES_FLAVOR=labs electron-vite build",
    "package:labs": "node scripts/package.mjs --labs",
    "install-app:labs": "node scripts/install-app.mjs --labs",
    "cli:labs": "node out-labs/main/cli.js"
  },
  "devDependencies": {
    "@milkdown/components": "file:src/labs/experiments/notes-view/vendor/milkdown-components-7.22.1-yaz1410.tgz",
    "@milkdown/crepe": "7.22.1",
    "@milkdown/kit": "7.22.1",
    "@milkdown/plugin-tooltip": "file:src/labs/experiments/notes-view/vendor/milkdown-plugin-tooltip-7.22.1-yaz2238.tgz",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.4.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  },
  "build": {
    "appId": "com.yaseen.videonotes",
    "productName": "Yaseen Video Notes",
    "directories": {
      "output": "dist-builder"
    },
    "files": [
      "out/**"
    ],
    "afterPack": "build/sign.cjs",
    "mac": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": null,
      "category": "public.app-category.education",
      "icon": "build/icon.icns"
    }
  },
  "allowScripts": {
    "electron@43.4.1": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  },
  "overrides": {
    "@milkdown/components": "$@milkdown/components",
    "@milkdown/plugin-tooltip": "$@milkdown/plugin-tooltip"
  }
}
