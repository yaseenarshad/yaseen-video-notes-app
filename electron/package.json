{
  "name": "follow-along",
  "productName": "Follow Along",
  "private": true,
  "version": "0.2.0",
  "description": "Follow Along: watch YouTube talks at 2–3× with a transcript that follows the video, notes saved in the transcript markdown (Electron)",
  "author": "Yasin Arshad",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "package": "node scripts/package.mjs",
    "cli": "node out/main/cli.js"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.4.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  },
  "build": {
    "appId": "com.yaseen.followalong",
    "productName": "Follow Along",
    "directories": {
      "output": "dist-builder"
    },
    "files": [
      "out/**"
    ],
    "afterPack": "build/sign.cjs",
    "mac": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": null,
      "category": "public.app-category.education",
      "icon": "build/icon.icns"
    }
  },
  "allowScripts": {
    "electron@43.4.1": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
